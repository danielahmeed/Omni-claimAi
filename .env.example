# OmniClaim AI - Google Cloud & Vertex AI Credentials
# Set your API keys or credentials below, or configure directly via the Web UI in "GCP Settings"

# 1. Gemini on Vertex AI / Google AI Studio API Key (Instant Live Activation)
# Get a key from: https://aistudio.google.com/app/apikey or Google Cloud Console
GEMINI_API_KEY=

# 2. Google Cloud Project Configuration (Optional for Vertex AI enterprise endpoint)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# 3. Document AI Processor Configuration (Optional for specialized invoice parser)
# Format: projects/{PROJECT_ID}/locations/{LOCATION}/processors/{PROCESSOR_ID}
DOCUMENT_AI_PROCESSOR_ID=
DOCUMENT_AI_LOCATION=us

# 4. Model Selection (Default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# 5. Service Account Key Path (Optional for ADC / gcloud)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
