# OmniClaim AI - local configuration.
# Copy this file to .env and fill in what you need. .env is git-ignored: never commit it.
# Every value is optional. With nothing set, the app runs in demo mode.

# --- Gemini --------------------------------------------------------------
# Option 1 (recommended): Gemini on Vertex AI. No API key needed.
#   Run `gcloud auth application-default login` once on this computer.
GOOGLE_CLOUD_PROJECT=
GEMINI_BACKEND=vertex
GEMINI_LOCATION=global

# Option 2: Gemini Developer API with a key from https://aistudio.google.com/app/apikey
#   Set GEMINI_BACKEND=api-key and paste the key below (or enter it in the app's AI settings).
# GEMINI_BACKEND=api-key
# GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.8-flash
# LOW (fastest), MEDIUM or HIGH. Only used for Gemini 3 and later models.
GEMINI_THINKING_LEVEL=LOW
GEMINI_TIMEOUT_SECONDS=90

# --- Optional Google Cloud services --------------------------------------
# Document AI Invoice Parser (create one: python tools/create_document_ai_processor.py --project my-project)
# DOCUMENT_AI_PROCESSOR=projects/my-project/locations/us/processors/PROCESSOR_ID

# Durable storage: claims in Firestore, photos and bills in Cloud Storage
# CLAIMS_STORE=firestore
# CLAIM_FILES_BUCKET=my-project-omniclaim-files

# BigQuery table with the historical claims (see docs/DEPLOYMENT.md, "BigQuery").
# BIGQUERY_BENCHMARK_TABLE=my-project.omniclaim.historical_claims

# --- Server ----------------------------------------------------------------
PORT=8080
# HOST=127.0.0.1
MAX_UPLOAD_MB=10
# Defaults: true locally, false on Cloud Run.
# ALLOW_SETTINGS_UI=true
# ALLOW_DATA_RESET=true
